# .env.example - Template pour les variables d'environnement
# Copie ce fichier vers .env et remplis les vraies valeurs

# Token d'authentification admin (genere un token securise)
ADMIN_TOKEN=your-secret-admin-token-here

# Mot de passe admin (utilise un mot de passe fort)
ADMIN_PASSWORD=your-secure-password-here

# Exemple de generation de token securise:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
